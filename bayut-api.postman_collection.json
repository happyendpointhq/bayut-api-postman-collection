              {
                "key": "X-RapidAPI-Host",
                "value": "{{rapidapi_host}}",
                "type": "text"
              },
              {
                "key": "x-rapidapi-key",
                "value": "{{rapidapi_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/agency-search?location_id=1&page=1&langs=en",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "agency-search"
              ],
              "query": [
                {
                  "key": "location_id",
                  "value": "1",
                  "description": "Required. - Location external ID\n- Get from `/autocomplete` endpoint (`externalID` field)\n- Example: `5001` (Dubai)\n- Example: `1` for whole of dubai, `3` for whole of Abu Dhabi",
                  "disabled": false
